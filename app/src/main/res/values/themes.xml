<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="NightAdjusted.Theme.Pochak" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Pochak" parent="NightAdjusted.Theme.Pochak" >
        <!--기본 Splash Screen 없애기-->
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="NightAdjusted.Theme.Splash" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Pochak.Splash" parent="NightAdjusted.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Pochak</item>
    </style>
</resources>